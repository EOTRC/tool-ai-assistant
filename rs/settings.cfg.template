# ============================================================
#  Tool — настройки локального ИИ-ассистента
#  Путь: settings.cfg рядом с исполняемым файлом Tool
#  Формат: [секция] / ключ = значение
#  Комментарии: строки, начинающиеся с # или ;
#  Удали файл — он пересоздастся с настройками по умолчанию.
# ============================================================

[general]
# Адрес сервера Ollama
ollama_host = http://localhost:11434
# Основная модель: лёгкая (1.7B), умнее qwen3:0.6b, быстрее qwen3:4b.
# Работает на CPU (см. [devices]). Для сложных задач поставь qwen3:4b.
model = qwen3:1.7b
# Модель для работы с кодом
coder_model = qwen2.5-coder:7b
# Модель для изображений и скриншотов
vision_model = qwen2.5vl:3b
# Модель эмбеддингов (поиск по документам, RAG)
embed_model = nomic-embed-text
# Язык ответов: ru / en
language = ru
# Режим думанья: on | off
#   off — модель отвечает сразу, без <think> (маркер /no_think добавляется
#         к каждому запросу: *no_think*, /no_think, no_thinking, /no_thinking)
#   on  — модель думает перед ответом
# Переключить на лету в чате: /think on | /think off
think = off
# Глобальный системный промт. Применяется ко ВСЕМ ИИ-запросам (chat, shell,
# screen и файловым командам). Например, можно задать роль или правила.
system_prompt =

[devices]
# Устройство для каждой модели:
#   cpu       — строго на CPU (не нагружает GPU)
#   gpu       — строго на GPU
#   gpu:N     — гибрид: N слоёв на GPU, остальное на CPU
# Модель qwen3:1.7b лёгкая и на CPU отвечает быстрее, чем на троттленной GPU.
qwen3:1.7b = cpu
qwen3:0.6b = cpu
qwen3:4b = gpu
qwen2.5-coder:7b = gpu
qwen2.5vl:3b = gpu
default = gpu

[aliases]
# Алиасы для toolcmd (консоль):  имя = команда
# После сохранения запусти toolcmd — алиасы подхватятся.
# reload = Tool settings view

[defaults]
# Разрешение конфликтов:  имя_команды = tool | system
# Когда команда есть и в Tool, и в Windows (например help),
# Tool один раз спрашивает, что использовать. Выбор "всегда"
# записывается сюда автоматически и действует во всех сессиях.
# help = tool
